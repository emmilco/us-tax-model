#!/usr/bin/env bash
# Refuses a commit unless its tree is exactly a tree a green check-all run
# tested: the last run in this worktree (tools/check_all.sh) or any recent
# green run of the clone, including one on a snapshot (tools/check_all_bg.sh).
# Enable once per clone with
#   git config core.hooksPath tools/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. tools/green.sh

if [ ! -s "$MARKER" ] && [ ! -s "$GREEN_TREES" ]; then
  echo "pre-commit: no green check-all run recorded; run npm run check-all" >&2
  exit 1
fi
staged="$(git write-tree)"
is_green "$staged" && exit 0

if [ -s "$MARKER" ] && [ "$(worktree_tree)" = "$(cat "$MARKER")" ]; then
  echo "pre-commit: the staged tree is only part of the tested tree; stage everything (git add -A) or rerun check-all" >&2
else
  echo "pre-commit: no green check-all run tested this tree; run npm run check-all, or commit a background run's tree with tools/commit_tested.sh" >&2
fi
exit 1
