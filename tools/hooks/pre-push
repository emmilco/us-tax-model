#!/usr/bin/env bash
# Refuses a push unless the tree of every commit being pushed to a ref passed a
# green check-all run (tools/green.sh: is_green). Commits are checked by
# tools/hooks/pre-commit, but git runs no pre-commit hook on a merge, so a merge
# made by `git pull` reaches this hook untested; run check-all on it first.
# Enabled with the other hooks:
#   git config core.hooksPath tools/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
. tools/green.sh

failed=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] && continue
  tree="$(git rev-parse "$local_sha^{tree}")"
  if ! is_green "$tree"; then
    echo "pre-push: $local_ref ($(git rev-parse --short "$local_sha")) has a tree no green check-all run tested; run npm run check-all (or npm run check-all-bg) on it first" >&2
    failed=1
  fi
done
exit "$failed"
