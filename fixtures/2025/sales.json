    {
      "id": "sales.refuse.wash_over_loss",
      "walk": "sales",
      "covers": [
        "sales.wash_bad"
      ],
      "evidence": "synthetic refusal regression",
      "evidence_note": "T-131, predicted from the sources before recording. Box A, detail, code W: proceeds $1,000, basis $1,200 (a $200 loss), wash-sale loss entered $449. i8949 p. 10, code W, \"You have a nondeductible loss from a wash sale\" and \"enter the amount of the nondeductible loss as a positive number in column (g)\"; p550 p. 86, \"A wash sale occurs when you sell or trade stock or securities at a loss\". The nondeductible loss cannot exceed the $200 loss, so the entry is refused as an entry error (gate sales[a].wash_bad) at column (g)'s wash-sale part and Form 1040 line 7a.",
      "inputs": {
        "$sales": [
          "a"
        ],
        "sales[a].code": "W",
        "sales[a].proceeds": 100000,
        "sales[a].reported_basis": 120000,
        "sales[a].wash_loss": 44900,
        "f1040.line25b": null,
        "f1040.line25c_other": null,
        "f8959.unsupported": null,
        "f1040.line26": null,
        "s179.line10": null
      },
      "expect": {
        "sales[a].w": {
          "kind": "refusal",
          "form": "Form 8949, column (g), code W",
          "remedy": "The nondeductible wash-sale loss entered is more than the loss on this sale (column (e) less column (d), after any code B correction). Check the amount against your Form 1099-B and your records.",
          "cite": {
            "doc": "i8949",
            "locator": "p. 10, code W, \"enter the amount of the nondeductible loss as a positive number in column (g)\"",
            "revision": "2025; printed date 2026-01-20",
