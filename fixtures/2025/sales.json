            "tax_year": 2025
          },
          "gate": "sales[a].wash_bad"
        },
        "f1040.line7a": {
          "kind": "refusal",
          "form": "Form 8949, column (g), code W",
          "remedy": "The nondeductible wash-sale loss entered is more than the loss on this sale (column (e) less column (d), after any code B correction). Check the amount against your Form 1099-B and your records.",
          "cite": {
            "doc": "i8949",
