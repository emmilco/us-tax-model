diff --git a/tools/blob_limit.sh b/tools/blob_limit.sh
new file mode 100644
index 0000000..dd43f8f
--- /dev/null
+++ b/tools/blob_limit.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+# Shared by tools/hooks/pre-commit and tools/hooks/pre-push: the limit on the size of one file (blob) a commit or push
+# adds. GitHub refuses a push holding a blob over 100 MiB and warns over 50 MiB, and a blob once committed leaves the
+# history only by rewriting it, so the hooks refuse a blob over MAX_BLOB_BYTES when it is added.
+#
+# A blob that cannot be made smaller yet may be listed in tools/large_blobs.txt, one per line as
+# "<blob id> <path> <reason>"; a listed blob is not refused. Blobs already in the remote's history are never read:
+# pre-push reads only the objects the push adds.
+MAX_BLOB_BYTES=52428800
+LARGE_BLOBS_LIST=tools/large_blobs.txt
+
+# oversized_blobs: reads "<object id> <path>" lines (git rev-list --objects, or the staged blobs) on standard input
+# and prints "<size> <blob id> <path>" for each blob over MAX_BLOB_BYTES that tools/large_blobs.txt does not list.
+oversized_blobs() {
+  local size id path
+  git cat-file --batch-check='%(objecttype) %(objectsize) %(objectname) %(rest)' |
+    awk -v max="$MAX_BLOB_BYTES" '$1 == "blob" && $2 > max { sub(/^blob /, ""); print }' |
+    while read -r size id path; do
+      if [ -f "$LARGE_BLOBS_LIST" ] && grep -q "^$id " "$LARGE_BLOBS_LIST"; then continue; fi
+      echo "$size $id $path"
+    done
+}
+
+# report_oversized WHO: prints one refusal line per oversized blob read on standard input (oversized_blobs output) and
+# fails when there was any.
+report_oversized() {
+  local size id path found=0
+  while read -r size id path; do
+    found=1
+    echo "$1: blob $id (${path:-no path}, $((size / 1048576)) MiB) is over the $((MAX_BLOB_BYTES / 1048576)) MiB limit (tools/blob_limit.sh); make the file smaller or leave it out. A blob that cannot be made smaller yet goes in $LARGE_BLOBS_LIST as \"$id ${path:-<path>} <reason>\"" >&2
+  done
+  return "$found"
+}
