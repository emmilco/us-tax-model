diff --git a/engine/src/mutate.ts b/engine/src/mutate.ts
index 26e375f..a5cec11 100644
--- a/engine/src/mutate.ts
+++ b/engine/src/mutate.ts
@@ -1919,8 +1919,6 @@ export const EQUIVALENT_IF: Record<string, Conditional> = {
     ["sa.standard", "sa.deduction", "sa.itemizes", "sa.standardraw", "sa.mfs_spouse_itemizes", "sa.extra_blind", "sa.elect_itemize"], "70cac84d5b693291", "sa.standardraw"),
   "operand.sa.sa.standard.zero.then0": pinned("sa.standard's mfs_spouse_itemizes-true alternative: standard is a helper read only by sa.itemizes and sa.deduction. In itemizes the mfs_spouse_itemizes disjunct is true and decides the any-test before its last disjunct, the only one that reads standard (an earlier unknown is outranked by the deciding true; an earlier refusal ends the test before standard is read); so itemizes is not false, and deduction reads standard only where itemizes is false or, as a way, unknown (spec 4.7.3). Where itemizes is unknown, mfs_spouse_itemizes is not true (a true disjunct decides the any-test), so the mutated alternative is not taken; where mfs_spouse_itemizes is unknown, standard's other alternative, standardraw, never refuses, so standard is that unknown on both routes.",
     ["sa.standard", "sa.deduction", "sa.itemizes", "sa.standardraw", "sa.mfs_spouse_itemizes", "sa.extra_blind", "sa.elect_itemize"], "70cac84d5b693291", "sa.extra_blind"),
-  "operand.sa.sa.gift_carryover_if_no_gifts.no.then1": pinned("sa.gift_carryover_if_no_gifts is a choice on sa.gifts: false takes the carryover answer sa.gift_carryover, true takes sa.no (the parameter sa.no, false); the mutant reads sa.charity_limited_if_gifts in place of sa.no. Its only reader is sa.line13, as its second refusal gate, after sa.charity_limited_if_gifts; gates are evaluated in order and a gate that is not a known false ends the list (spec 4.7.1), so the line is read only where sa.charity_limited_if_gifts is a memoized false, which on the gifts-true alternative is the mutant's value and equals sa.no. Where sa.gifts is unknown, sa.charity_limited_if_gifts (a choice on the same sa.gifts) is not a known false, so the list ends before the line is read; where sa.gifts is a refusal, both lines are that refusal and the list ends at the first gate.",
-    ["sa.gift_carryover_if_no_gifts", "sa.line13", "sa.charity_limited_if_gifts", "sa.gifts", "sa.gift_carryover", "sa.no", "param:sa.no"], "2b2ce17871763401", "sa.charity_limited_if_gifts"),
   "operand.sa.sa.medical_premiums_if_not_large.no.then1": pinned("sa.medical_premiums_if_not_large is a choice on sa.medical_any: false takes the premiums answer sa.medical_premiums, true takes sa.no (the parameter household.no, false); the mutant reads sa.age65 in place of sa.no. Its only reader is sa.medical_asked, any[medical_any is true, medical_premiums_if_not_large is true], evaluated in order: where sa.medical_any is true the first disjunct decides the any-test and the line is not read (an any-test returns at its first true disjunct). Where sa.medical_any is a refusal the guard refuses and both routes are that refusal. Where it is unknown both alternatives are ways (spec 4.7.3); the first way, the input sa.medical_premiums, is never a refusal, so the line is sa.medical_any's unknown on both routes.",
     ["sa.medical_premiums_if_not_large", "sa.medical_asked", "sa.medical_any", "sa.medical_premiums", "sa.no", "param:household.no"], "12e3d2e108ea2bda", "sa.age65"),
   "operand.sa.sa.home_other_if_not_owner.no.then1": pinned("sa.home_other_if_not_owner is a choice on sa.home_owner: false takes the answer sa.home_other, true takes sa.no (the parameter household.no, false); the mutant reads sa.medical_asked in place of sa.no. Its only reader is sa.home_asked, any[home_owner is true, home_other_if_not_owner is true], evaluated in order: where sa.home_owner is true the first disjunct decides the any-test and the line is not read. Where sa.home_owner is a refusal the guard refuses and both routes are that refusal. Where it is unknown both alternatives are ways (spec 4.7.3); the first way, the input sa.home_other, is never a refusal, so the line is sa.home_owner's unknown on both routes.",
