+      doc: i1040se
+      locator: p. 9, Part II, "If you report a loss on Schedule E from a partnership or S corporation engaged in a trade or
+        business, use Form 461 to figure your excess business loss"
+    ambiguity: amb.2025.s1_ebl_rental
+  - id: k1p.qbi_loss_abs
+    printed: (helper)
+    label: A qualified business loss in box 20, code Z, as a positive amount
+    type: NonNegDollars
+    expr:
+      op: subtract_floor0
+      from: k1p.zero
+      take: k1p.box20z_if_any
+    cite: &id210
+      doc: i8995
+      locator: p. 3, "If a loss or deduction is partially suspended, only the portion of the allowed loss or deduction attributable
+        to QBI must be considered when determining QBI from the trade or business in the year the loss or deduction is incurred"
+  - id: k1p.qbi_limited
+    printed: (helper)
+    label: The box 20, code Z amount is a loss and the box 1 activity has a passive net loss this year
+    type: Bool
+    expr:
+      op: test
+      all:
+      - op: test
+        gt:
+        - k1p.qbi_loss_abs
+        - const: 0
+      - op: test
+        gt:
+        - k1p.b1_net_loss
+        - const: 0
+    cite: *id210
+    ambiguity: amb.2025.k1p_qbi_passive
+  - id: k1p.qbi_loss_allowed
+    printed: (helper)
+    label: The qualified business loss times the allowed share of the box 1 loss
+    type: NonNegDollars
+    expr:
+      op: prorate
+      amount: k1p.qbi_loss_abs
+      part: k1p.b1_allowed
+      whole: k1p.b1_net_loss
+      places: 6
+    cite:
+      doc: i8995
+      locator: p. 3, "The allowed loss or deduction is then multiplied by this percentage to determine the portion of the
+        allowed loss or deduction attributable to QBI"
+    ambiguity: amb.2025.k1p_qbi_passive
+  - id: k1p.qbi_neg_allowed
+    printed: (helper)
+    label: The allowed qualified business loss (negative)
+    type: Dollars
+    expr:
+      op: subtract
+      from: k1p.zero
+      take: k1p.qbi_loss_allowed
+    cite: *id210
+  - id: k1p.qbi_after_pal
+    printed: (helper)
+    label: Qualified business income or loss after the passive activity limit
+    type: Dollars
+    expr:
+      op: choose
+      alternatives:
+      - guard:
+          op: test
+          eq:
+          - k1p.qbi_limited
+          - const: true
+        then: k1p.qbi_neg_allowed
+      - guard:
+          op: test
+          eq:
+          - k1p.qbi_limited
+          - const: false
+        then: k1p.box20z_if_any
+    cite: *id210
+  - id: k1p.qbi_release
+    printed: (gate)
+    label: A box 1 loss held back in an earlier year is allowed in part or whole this year, and box 20 shows code Z
+    type: Bool
+    expr:
+      op: test
+      all:
+      - op: test
+        gt:
+        - k1p.prior_b1_if
+        - const: 0
+      - op: test
+        gt:
+        - k1p.b1_allowed
+        - const: 0
+      - op: test
+        eq:
+        - k1p.has_b20z
+        - const: true
+    cite: &id211
+      doc: i8995
+      locator: p. 3, "When losses or deductions previously suspended by other Code provisions are allowed in calculating taxable
+        income"
+  - id: k1p.has_se_pos
+    printed: (helper)
+    label: Box 14, code A shows positive self-employment earnings
+    type: Bool
+    expr:
+      op: test
+      gt:
+      - k1p.se_pos
+      - const: 0
+    cite:
+      doc: i8995
+      locator: p. 2, Determining Your Qualified Business Income, "deductible part of self-employment tax"
+  - id: k1p.qbi_se
+    printed: (helper)
+    label: Deductible part of self-employment tax attributable to this partnership (zero without positive earnings)
+    type: NonNegDollars
+    expr:
+      op: choose
+      alternatives:
+      - guard:
+          op: test
+          eq:
+          - k1p.has_se_pos
+          - const: true
+        then: k1p.qbi_se_share
+      - guard:
+          op: test
+          eq:
+          - k1p.has_se_pos
+          - const: false
+        then: k1p.zero
+    cite:
+      doc: i8995
+      locator: p. 2, Determining Your Qualified Business Income, "deductible part of self-employment tax"
+    ambiguity: amb.2025.qbi_attribution
+  - id: k1p.qbi_se_share
+    printed: (helper)
+    label: This person's deductible part of self-employment tax attributable to this partnership (by share of positive
+      earnings)
+    type: NonNegDollars
+    expr:
+      op: prorate
+      amount: person.se_line13
+      part: k1p.se_pos
+      whole: person.se_pos_whole
+      places: 6
+    cite:
+      doc: i8995
+      locator: p. 2, Determining Your Qualified Business Income, "deductible part of self-employment tax"
+    ambiguity: amb.2025.qbi_attribution
+  - id: k1p.qbi
+    printed: 1(c)
+    label: Qualified business income or (loss) of this partnership after the passive activity limit and the self-employment
+      tax attributable to it
+    type: Dollars
+    expr:
+      op: subtract
+      from: k1p.qbi_after_pal
+      take: k1p.qbi_se
+    cite: *id210
+    refuses:
+    - when: k1p.qbi_release
+      form: Form 8995-A Schedule C (prior-year suspended loss allowed this year)
+      remedy: A partnership loss held back in an earlier year and allowed this year changes qualified business income in a way
+        this tool does not figure.
+      cite: *id211
   - id: k1p.screened
     printed: (gate)
     label: This Schedule K-1 passed every screen (true; the refusals of a K-1 are told here)
