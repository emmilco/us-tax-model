         child of any other person (other than your spouse if filing jointly)"), so a child who lived with both is the
diff --git a/forms/2025/k1p.yaml b/forms/2025/k1p.yaml
index d10c1b3..0907beb 100644
--- a/forms/2025/k1p.yaml
+++ b/forms/2025/k1p.yaml
@@ -2749,6 +2749,183 @@ form:
     cite:
       doc: i1040se
       locator: p. 10, Line 28, Column (g), "enter in column (g) the loss allowed"
+  - id: k1p.ebl_loss
+    printed: (helper)
+    label: Losses in boxes 1, 2 and 3 before the passive activity limit, for the excess business loss screen (positive)
+    type: NonNegDollars
+    expr:
+      op: sum
+      of:
+      - k1p.b1_neg
+      - k1p.b2_neg
+      - k1p.b3_neg
