diff --git a/engine/src/generate.ts b/engine/src/generate.ts
index ea8149e..356a692 100644
--- a/engine/src/generate.ts
+++ b/engine/src/generate.ts
@@ -667,7 +667,15 @@ function buildInputs(data: CanonicalData, s: Spec): Inputs {
   inputs["sa.line1"] = s.medical; inputs["sa.line5a"] = s.saltIncome; inputs["sa.line5b"] = s.saltRe;
   inputs["sa.mortgage_interest"] = s.mortgage; inputs["sa.line11"] = s.cashGifts;
   inputs["$gift"] = s.gifts.map((_, i) => `item_${String.fromCharCode(97 + i)}`);
-  s.gifts.forEach((g, i) => { for (const [k, v] of Object.entries(g)) inputs[`gift[item_${String.fromCharCode(97 + i)}].${k}`] = v; });
+  // A special gift is drawn as one fact and given as the inventory item; the other special-treatment items are No.
+  const GIFT_SPECIAL = ["vehicle", "passthrough", "ip", "inventory", "clothing_poor", "unrelated_use", "k1", "partial", "restricted", "private_fdn", "use_only"];
+  s.gifts.forEach((g, i) => {
+    const G = `gift[item_${String.fromCharCode(97 + i)}]`;
+    for (const [k, v] of Object.entries(g)) {
+      if (k === "special") for (const item of GIFT_SPECIAL) inputs[`${G}.${item}`] = item === "inventory" ? v : false;
+      else inputs[`${G}.${k}`] = v;
+    }
+  });
   inputs["$dependent"] = s.dependents.map((_, i) => `dep_${String.fromCharCode(97 + i)}`);
   s.dependents.forEach((d, i) => { for (const [k, v] of Object.entries(d)) inputs[`dependent[dep_${String.fromCharCode(97 + i)}].${k}`] = v; });
   // An "other" household member's relationship is lawful (Step 4); answered without a draw, so the stream is unchanged.
