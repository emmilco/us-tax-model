--- /dev/null
+++ b/interview/2025/coverage/k1s.yaml
@@ -0,0 +1,53 @@
+tax_year: 2025
+part: S corporation Schedules K-1
+profile: full
+sets:
+  one_k1s:
+    says: One person with one Schedule K-1 (Form 1120-S) from an S corporation.
+    answers:
+      scope.k1: true
+      $k1p@person[taxpayer]: []
+      $k1s@person[taxpayer]: [acme]
+rows:
+  - id: k1s.refuse_multi
+    design: k1block unit 9 (k1s R-gate k1s.multi, boxes 18 and 19)
+    situation: An S corporation K-1 with box 18 checked (more than one activity).
+    uses: [one_k1s]
+    answers:
+      person[taxpayer].k1s[acme].multi: true
+    expect:
+      refused: person[taxpayer].k1s[acme].multi
+  - id: k1s.refuse_disposed
+    design: k1block unit 9 (k1s R-gate k1s.disposed)
+    situation: A shareholder sold some of her S corporation shares back to the corporation in 2025.
+    uses: [one_k1s]
+    answers:
+      person[taxpayer].k1s[acme].multi: false
+      person[taxpayer].k1s[acme].disposed: true
+    expect:
+      refused: person[taxpayer].k1s[acme].disposed
+  - id: k1s.portfolio_interest
+    design: k1block unit 9 (an S corporation K-1 with interest only; no participation or basis questions)
+    situation: A shareholder whose S corporation K-1 shows only interest income in box 4.
+    uses: [one_k1s]
+    answers:
+      person[taxpayer].k1s[acme].multi: false
+      person[taxpayer].k1s[acme].disposed: false
+      person[taxpayer].k1s[acme].box4_any: true
+      person[taxpayer].k1s[acme].box4: 25000
+    expect:
+      proceeds:
+        person[taxpayer].k1s[acme].box4: 25000
+      not_asked:
+        - person[taxpayer].k1s[acme].work
+        - person[taxpayer].k1s[acme].hours500
+  - id: k1s.refuse_box10
+    design: k1block unit 9 (k1s R-gate k1s.box10)
+    situation: An S corporation K-1 shows other income in box 10.
+    uses: [one_k1s]
+    answers:
+      person[taxpayer].k1s[acme].multi: false
+      person[taxpayer].k1s[acme].disposed: false
+      person[taxpayer].k1s[acme].box10: true
+    expect:
+      refused: person[taxpayer].k1s[acme].box10
