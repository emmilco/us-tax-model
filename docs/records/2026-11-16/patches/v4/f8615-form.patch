+# Qualified Dividends and Capital Gain Tax Worksheet on a bound amount and filing status.
+#
+# The worksheet of i1040gi p. 38 with its inputs bound by the calling line: the amount for line 1, the qualified
+# dividends for line 2, the net capital gain for line 3, and the filing status that lines 6, 13, 22 and 24 use. Form
+# 8615 lines 9 and 15 say to figure the tax with this worksheet on an amount that is not the return's taxable income,
+# at the parent's or the child's filing status. Lines 6 and 13 read keyed tables by the bound status, which equal the
+# year parameters the return's own worksheet (qdcg) reads.
+
+def:
+  id: qdcg_amount
+  kind: def
+  title: "Qualified Dividends and Capital Gain Tax Worksheet on a bound amount and filing status"
+  tax_year: 2025
+  parameters: [amount, qd, ncg, status]
+  lines:
+
+    - id: amount
+      printed: "1"
+      label: "The amount whose tax is figured (line 1)"
+      type: NonNegDollars
+      expr: { op: input, source: "Bound by the calling line (the amount the worksheet's line 1 holds)." }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 1, "Enter the amount from Form 1040 or 1040-SR, line 15"' }
+
+    - id: qd
+      printed: "2"
+      label: "The qualified dividends included in the amount (line 2)"
+      type: NonNegDollars
+      expr: { op: input, source: "Bound by the calling line (the qualified dividends the worksheet's line 2 holds)." }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 2, "Enter the amount from Form 1040 or 1040-SR, line 3a"' }
+
+    - id: ncg
+      printed: "3"
+      label: "The net capital gain included in the amount (line 3)"
+      type: NonNegDollars
+      expr: { op: input, source: "Bound by the calling line (the net capital gain the worksheet's line 3 holds)." }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 3, "Are you filing Schedule D?"' }
+
+    - id: status
+      printed: "(status)"
+      label: "The filing status the worksheet is figured at"
+      type: Enum(filing_status)
+      expr: { op: input, source: "Bound by the calling line (a filing status)." }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 6, "$48,350 if single or married filing separately,"' }
+
+    - id: line4
+      printed: "4"
+      label: "Add lines 2 and 3"
+      type: NonNegDollars
+      expr: { op: sum, of: ["qd", "ncg"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 4, "Add lines 2 and 3"' }
+
+    - id: line5
+      printed: "5"
+      label: "Subtract line 4 from line 1. If zero or less, enter -0-"
+      type: NonNegDollars
+      expr: { op: subtract_floor0, from: "amount", take: "line4" }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 5, "Subtract line 4 from line 1. If zero or less, enter -0-"' }
+
+    - id: line6
+      printed: "6"
+      label: "Enter: $48,350 if single or married filing separately, $96,700 if married filing jointly or qualifying surviving spouse, $64,750 if head of household"
+      type: NonNegDollars
+      expr: { op: keyed_lookup, table: qdcg_zero_ceiling, keys: ["status"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 6, "$48,350 if single or married filing separately,"' }
+
+    - id: line7
+      printed: "7"
+      label: "Enter the smaller of line 1 or line 6"
+      type: NonNegDollars
+      expr: { op: smaller_of, of: ["amount", "line6"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 7, "Enter the smaller of line 1 or line 6"' }
+
+    - id: line8
+      printed: "8"
+      label: "Enter the smaller of line 5 or line 7"
+      type: NonNegDollars
+      expr: { op: smaller_of, of: ["line5", "line7"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 8, "Enter the smaller of line 5 or line 7"' }
+
+    - id: line9
+      printed: "9"
+      label: "Subtract line 8 from line 7. This amount is taxed at 0%"
+      type: Dollars
+      expr: { op: subtract, from: "line7", take: "line8" }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 9, "Subtract line 8 from line 7. This amount is taxed at 0%"' }
+
+    - id: line10
+      printed: "10"
+      label: "Enter the smaller of line 1 or line 4"
+      type: NonNegDollars
+      expr: { op: smaller_of, of: ["amount", "line4"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 10, "Enter the smaller of line 1 or line 4"' }
+
+    - id: line11
+      printed: "11"
+      label: "Enter the amount from line 9"
+      type: Dollars
+      expr: { op: copy, from: "line9" }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 11, "Enter the amount from line 9"' }
+
+    - id: line12
+      printed: "12"
+      label: "Subtract line 11 from line 10"
+      type: Dollars
+      expr: { op: subtract, from: "line10", take: "line11" }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 12, "Subtract line 11 from line 10"' }
+
+    - id: line13
+      printed: "13"
+      label: "Enter: $533,400 if single, $300,000 if married filing separately, $600,050 if married filing jointly or qualifying surviving spouse, $566,700 if head of household"
+      type: NonNegDollars
+      expr: { op: keyed_lookup, table: qdcg_fifteen_ceiling, keys: ["status"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 13, "$533,400 if single,"' }
+
+    - id: line14
+      printed: "14"
+      label: "Enter the smaller of line 1 or line 13"
+      type: NonNegDollars
+      expr: { op: smaller_of, of: ["amount", "line13"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 14, "Enter the smaller of line 1 or line 13"' }
+
+    - id: line15
+      printed: "15"
+      label: "Add lines 5 and 9"
+      type: Dollars
+      expr: { op: sum, of: ["line5", "line9"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 15, "Add lines 5 and 9"' }
+
+    - id: line16
+      printed: "16"
+      label: "Subtract line 15 from line 14. If zero or less, enter -0-"
+      type: NonNegDollars
+      expr: { op: subtract_floor0, from: "line14", take: "line15" }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 16, "Subtract line 15 from line 14. If zero or less, enter -0-"' }
+
+    - id: line17
+      printed: "17"
+      label: "Enter the smaller of line 12 or line 16"
+      type: Dollars
+      expr: { op: smaller_of, of: ["line12", "line16"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 17, "Enter the smaller of line 12 or line 16"' }
+
+    - id: line18
+      printed: "18"
+      label: "Multiply line 17 by 15% (0.15)"
+      type: Dollars
+      expr: { op: multiply_rate, amount: "line17", rate: { param: "qdcg.rate_15" } }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 18, "Multiply line 17 by 15% (0.15)"' }
+
+    - id: line19
+      printed: "19"
+      label: "Add lines 9 and 17"
+      type: Dollars
+      expr: { op: sum, of: ["line9", "line17"] }
+      cite: { doc: i1040gi, locator: 'p. 38, Qualified Dividends and Capital Gain Tax Worksheet, line 19, "Add lines 9 and 17"' }
+
+    - id: line20
+      printed: "20"
