diff --git a/tools/check_qdcg_ceiling.py b/tools/check_qdcg_ceiling.py
new file mode 100644
index 0000000..3a74735
--- /dev/null
+++ b/tools/check_qdcg_ceiling.py
@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+"""Check that the keyed tables qdcg_zero_ceiling and qdcg_fifteen_ceiling equal the year parameters they copy.
+
+The Qualified Dividends and Capital Gain Tax Worksheet's lines 6 and 13 are read two ways: the return's own worksheet
+(form qdcg) reads the status-keyed parameters qdcg.zero_rate_ceiling and qdcg.fifteen_rate_ceiling at the return's
+filing status, and the def qdcg_amount, bound to another filing status, reads the keyed tables. This check fails when
+a table row and its parameter disagree, or a status is missing on either side, so the two copies cannot drift.
+
+Usage: python3 tools/check_qdcg_ceiling.py [--year N] [--self-test]
+"""
+import argparse
+import sys
+from pathlib import Path
+
+import yaml
+
+ROOT = Path(__file__).resolve().parent.parent
+PAIRS = (("qdcg_zero_ceiling", "qdcg.zero_rate_ceiling"), ("qdcg_fifteen_ceiling", "qdcg.fifteen_rate_ceiling"))
+
+
+def find_param(params, key):
+    """The parameter entry for key, wherever the year file nests it."""
+    if isinstance(params, dict):
+        if key in params and isinstance(params[key], dict) and "value" in params[key]:
+            return params[key]
+        for v in params.values():
+            hit = find_param(v, key)
+            if hit is not None:
+                return hit
+    return None
+
+
+def compare(table, param):
+    """Problems between a keyed table (status -> value) and a status-keyed parameter value."""
+    problems = []
+    rows = {}
+    for row in table["rows"]:
+        (status,) = row["keys"]
+        if status in rows:
+            problems.append(f"{table['id']}: status {status} appears twice")
+        rows[status] = row["value"]
+    value = param["value"]
+    if not isinstance(value, dict):
+        return [f"{table['id']}: its parameter is not keyed by filing status"]
+    for status in sorted(set(rows) | set(value)):
+        if status not in rows:
+            problems.append(f"{table['id']}: no row for {status}")
+        elif status not in value:
+            problems.append(f"{table['id']}: row {status} has no parameter value")
+        elif rows[status] != value[status]:
+            problems.append(f"{table['id']}: {status} is {rows[status]} in the table, {value[status]} in the parameter")
+    return problems
+
+
+def check(year):
+    params = yaml.safe_load((ROOT / "params" / f"{year}.yaml").read_text(encoding="utf-8"))
+    problems = []
+    for table_id, param_id in PAIRS:
+        path = ROOT / "tables" / str(year) / f"{table_id}.yaml"
+        if not path.exists():
+            problems.append(f"{path.relative_to(ROOT)} is missing")
+            continue
+        table = yaml.safe_load(path.read_text(encoding="utf-8"))["table"]
+        param = find_param(params, param_id)
+        if param is None:
+            problems.append(f"parameter {param_id} is missing from params/{year}.yaml")
+            continue
+        problems += compare(table, param)
+    return problems
+
+
+def self_test():
+    good = {"id": "t", "rows": [{"keys": ["single"], "value": 1}, {"keys": ["mfj"], "value": 2}]}
+    param = {"value": {"single": 1, "mfj": 2}}
+    cases = [
+        ("equal copies pass", compare(good, param) == []),
+        ("a different value fails", compare(good, {"value": {"single": 1, "mfj": 3}}) != []),
+        ("a status missing from the table fails", compare(good, {"value": {"single": 1, "mfj": 2, "hoh": 4}}) != []),
+        ("a status missing from the parameter fails", compare(good, {"value": {"single": 1}}) != []),
+        ("a repeated row fails", compare({"id": "t", "rows": good["rows"] + [{"keys": ["mfj"], "value": 2}]}, param) != []),
+        ("an unkeyed parameter fails", compare(good, {"value": 5}) != []),
+    ]
+    bad = [name for name, ok in cases if not ok]
+    for name in bad:
+        print(f"self-test failed: {name}")
+    print(f"check_qdcg_ceiling self-test: {len(cases) - len(bad)}/{len(cases)} passed")
+    return 1 if bad else 0
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--year", type=int, default=2025)
+    ap.add_argument("--self-test", action="store_true")
+    args = ap.parse_args()
+    if args.self_test:
+        return self_test()
+    problems = check(args.year)
+    for p in problems:
+        print(p)
+    print(f"check_qdcg_ceiling {args.year}: {'ok' if not problems else f'{len(problems)} problem(s)'}")
+    return 1 if problems else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
