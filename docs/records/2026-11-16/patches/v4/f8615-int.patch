diff --git a/interview/2025/coverage/kiddie.yaml b/interview/2025/coverage/kiddie.yaml
new file mode 100644
index 0000000..702a91a
--- /dev/null
+++ b/interview/2025/coverage/kiddie.yaml
@@ -0,0 +1,191 @@
+# Coverage rows for the tax on a child's income at a parent's rate (Form 8615, topic 277). See opening.yaml for how a
+# row is read. The typical filer is a 17-year-old with a custodial or brokerage account whom the parents claim.
+tax_year: 2025
+part: Tax on a child's income at a parent's rate (Form 8615)
+profile: full
+sets:
+  kid17:
+    says: A single 17-year-old whom the parents can claim, with a bank or brokerage account in their own name.
+    answers:
+      $person: [taxpayer]
+      f1040.status: single
+      household.ever_married: false
+      sa.dependent: true
+      person[taxpayer].birth_year: 2008
+      $interest: [bank]
+      interest[bank].penalty: 0
+      sb.nominee: false
+      sb.bonds_any: false
+      ftc.taxes: 0
+  parent_mfj:
+    says: The parents file one joint return with taxable income of $150,000, tax of $22,828 and no dividends or gains.
+    answers:
+      person[taxpayer].edu_parent: true
+      f8615.parent_status: mfj
+      f8615.parent_sdtw: false
+      f8615.parent_sj: false
+      f8615.parent_feitw: false
+      f8615.parent_ti: 15000000
+      f8615.parent_tax: 2282800
+      f8615.parent_qd: 0
+      f8615.parent_ncg: 0
+rows:
+  - id: kiddie.interest_parent_mfj
+    design: scout-8615 section 5 (the typical filer; fixture K1)
+    situation: A 17-year-old with $10,000 of interest, whose parents file jointly, copies five figures from the parents' return and the return is prepared.
+    uses: [kid17, parent_mfj]
+    answers:
+      interest[bank].amount: 1000000
+      f8615.other_children: false
+    expect:
+      proceeds:
+        f8615.other_children: false
+  - id: kiddie.qd_ws1
+    design: "scout-8615 section 5 (qualified dividends through Line 5 Worksheet #1; fixture K4)"
+    situation: A 17-year-old with $6,000 of qualified dividends from a custodial account and no interest, whose parents file jointly, completes the return.
+    uses: [kid17, parent_mfj]
+    answers:
+      $interest: []
+      div.any: true
+      div.other_boxes: false
+      sb.ordinary_dividends: 600000
+      f1040.line3a: 600000
+      sd.distributions: 0
+      qbi.dividends: 0
+      f8615.other_children: false
+    expect:
+      proceeds:
+        f8615.other_children: false
+  - id: kiddie.other_children
+    design: scout-8615 section 5 (line 7, other children; fixture K6)
+    situation: A 17-year-old with $5,700 of interest whose brother and sister also file this form on the same parents' return enters their line 5 total of $6,000.
+    uses: [kid17, parent_mfj]
+    answers:
+      interest[bank].amount: 570000
+      f8615.other_children: true
+      f8615.others_line5: 600000
+      f8615.others_qd: 0
+      f8615.others_ncg: 0
+      f8615.others_sdtw: false
+    expect:
+      proceeds:
+        f8615.others_line5: 600000
+  - id: kiddie.line5_zero
+    design: scout-8615 section 5 (the form applies but line 5 is zero; no parent figure is needed)
+    situation: A full-time student of 20 who supports herself, with $9,000 of interest and no taxable income, is not asked about a parent's return.
+    answers:
+      $person: [taxpayer]
+      f1040.status: single
+      household.ever_married: false
+      sa.dependent: false
+      person[taxpayer].birth_year: 2005
+      person[taxpayer].edu_half_support: true
+      person[taxpayer].edu_fulltime: true
+      person[taxpayer].edu_parent: true
+      $interest: [bank]
+      interest[bank].amount: 900000
+      interest[bank].penalty: 0
+    expect:
+      proceeds:
+        person[taxpayer].edu_parent: true
+      not_asked: [f8615.parent_status, f8615.parent_ti]
+  - id: kiddie.amt
+    design: scout-8615 section 3.3 (the child's alternative minimum tax exemption cap; fixture K11)
+    situation: A 17-year-old with $50,000 of interest, whose parents have $40,000 of taxable income, is told the alternative minimum tax applies.
+    uses: [kid17, parent_mfj]
+    answers:
+      interest[bank].amount: 5000000
+      f8615.parent_ti: 4000000
+      f8615.parent_tax: 432600
+      f8615.other_children: false
+    expect:
+      refused: s2.amt
+  - id: kiddie.parent_sdtw
+    design: scout-8615 section 4 (the parent's Schedule D Tax Worksheet; fixture K9)
+    situation: A 17-year-old with $10,000 of interest ticks that the parents' tax was figured on the Schedule D Tax Worksheet, and is told at that screen.
+    uses: [kid17]
+    answers:
+      interest[bank].amount: 1000000
+      person[taxpayer].edu_parent: true
+      f8615.parent_status: mfj
+      f8615.parent_sdtw: true
+      f8615.parent_sj: false
+      f8615.parent_feitw: false
+    expect:
+      refused: f8615.parent_sdtw_if_applies
+      not_asked: [f8615.parent_ti]
+  - id: kiddie.parent_sj
+    design: scout-8615 section 4 (the parent's Schedule J)
+    situation: A 17-year-old with $10,000 of interest whose parent averaged farm income on Schedule J is told at that screen.
+    uses: [kid17]
+    answers:
+      interest[bank].amount: 1000000
+      person[taxpayer].edu_parent: true
+      f8615.parent_status: mfj
+      f8615.parent_sdtw: false
+      f8615.parent_sj: true
+      f8615.parent_feitw: false
+    expect:
+      refused: f8615.parent_special
+  - id: kiddie.child_itemizes
+    design: scout-8615 section 4 (a child who itemizes)
+    situation: A 17-year-old with $10,000 of interest who chooses to itemize deductions is told that line 2 is not figured.
+    uses: [kid17]
+    answers:
+      interest[bank].amount: 1000000
+      person[taxpayer].edu_parent: true
+      sa.elect_itemize: true
+    expect:
+      refused: f8615.child_itemizes
+  - id: kiddie.not_asked_over24
+    design: "scout-8615 section 5 (the filer with nothing in the area: 24 or over)"
+    situation: A single person of 35 with $10,000 of interest is asked nothing about a parent.
+    answers:
+      $person: [taxpayer]
+      f1040.status: single
+      household.ever_married: false
+      person[taxpayer].birth_year: 1990
+      $interest: [bank]
+      interest[bank].amount: 1000000
+      interest[bank].penalty: 0
+    expect:
+      proceeds:
+        f1040.status: single
+      not_asked: ["person[taxpayer].edu_parent", f8615.parent_status]
+  - id: kiddie.not_asked_joint
+    design: "scout-8615 section 5 (the filer with nothing in the area: a joint return)"
+    situation: A married couple of 22 filing jointly with $10,000 of interest is asked nothing about a parent.
+    answers:
+      $person: [taxpayer, spouse]
+      f1040.status: mfj
+      household.married_dec31: true
+      person[taxpayer].birth_year: 2003
+      person[spouse].birth_year: 2003
+      $interest: [bank]
+      interest[bank].amount: 1000000
+      interest[bank].penalty: 0
+    expect:
+      proceeds:
+        f1040.status: mfj
+      not_asked: [f8615.parent_status]
+  - id: kiddie.not_asked_small
+    design: "scout-8615 section 5 (the filer with nothing in the area: $2,700 or less of income other than pay; replaces scope.under24_small_income)"
+    situation: A 17-year-old with $2,000 of interest is asked nothing about a parent or about support.
+    uses: [kid17]
+    answers:
+      interest[bank].amount: 200000
+    expect:
+      proceeds:
+        sa.dependent: true
+      not_asked: ["person[taxpayer].edu_parent", f8615.parent_status]
+  - id: kiddie.no_parent_alive
+    design: "scout-8615 section 1 (condition 4: no parent alive; fixture K10)"
+    situation: A 17-year-old claimed by a grandparent, with no parent alive, and $10,000 of interest, is not asked about a parent's return.
+    uses: [kid17]
+    answers:
+      interest[bank].amount: 1000000
+      person[taxpayer].edu_parent: false
+    expect:
+      proceeds:
+        person[taxpayer].edu_parent: false
+      not_asked: [f8615.parent_status]
