  {
   "key": "regular_tax",
   "record": "c447c304498f50167b7d43b1b58ad5c7b22897f860a8e618bd19cc66a8af21fa",
   "status": "MISMATCH",
   "ruling": "Ruling: scope; i1116 p. 25, Line 20: regular tax is Form 1040 line 16 plus Schedule 2 line 1z \"less any tax included on line 16 from Form 4972\". Form 4972 tax is refused at Form 1040 line 16 (scope.other_line16), so nothing is subtracted on a computed return. Same as the landing and goal-1 rulings on line limited.",
   "subject_key": "6edaa7f139427fe14a9443478172ec4dc6295fa6b63b528311393bf6e317d34e"
  },
